{
  "manifest_version": 3,
  "name": "Smart AI Email Assistant",
  "version": "1.0.0",
  "description": "Generate AI-powered email replies directly inside Gmail.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://smart-email-assistant-api-is75.onrender.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}